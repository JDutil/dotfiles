# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/.dotfiles

# Docker
export DOCKER_MACHINE_NAME=default

# your project folder that we can `c [tab]` to
export PROJECTS=~/Code

# use .localrc for SUPER SECRET CRAP that you don't
# want in your public, versioned repo.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit
compinit

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files

# NODE
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvm
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

# RUBY
source /usr/local/share/chruby/chruby.sh
source /usr/local/share/chruby/auto.sh

#export NODE_PATH="/usr/local/lib/node_modules"
#export PATH="/usr/local/bin:$PATH"

#. $HOME/.asdf/asdf.sh
#. $HOME/.asdf/completions/asdf.bash


# JUUL
#eval "$(direnv hook zsh)"
#source ~/.juul/aws-environment.sh

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/jdutil/Downloads/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/jdutil/Downloads/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/jdutil/Downloads/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/jdutil/Downloads/google-cloud-sdk/completion.zsh.inc'; fi

# heroku autocomplete setup
HEROKU_AC_ZSH_SETUP_PATH=/Users/jdutil/Library/Caches/heroku/autocomplete/zsh_setup && test -f $HEROKU_AC_ZSH_SETUP_PATH && source $HEROKU_AC_ZSH_SETUP_PATH;
